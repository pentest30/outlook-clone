<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Outlook.App.ViewModels"
        x:Class="Outlook.App.Views.RemindersWindow"
        x:DataType="vm:RemindersViewModel"
        Title="Reminders"
        Width="460" Height="360" MinWidth="360" MinHeight="220"
        Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}">
  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <Button Grid.Column="1" Content="Dismiss all" Command="{Binding DismissAllCommand}" />
    </Grid>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReminderItemViewModel">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="4,8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="🔔" FontSize="18" VerticalAlignment="Top" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding When}" FontSize="12" Classes="muted" />
                  <TextBlock Text="{Binding Location}" FontSize="12" Classes="muted" />
                  <TextBlock Text="{Binding DueText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                  <Button Content="Dismiss" HorizontalAlignment="Stretch"
                          Command="{Binding $parent[Window].((vm:RemindersViewModel)DataContext).DismissCommand}" CommandParameter="{Binding}" />
                  <Button Content="Snooze 5 min" HorizontalAlignment="Stretch"
                          Command="{Binding $parent[Window].((vm:RemindersViewModel)DataContext).SnoozeCommand}" CommandParameter="{Binding}" />
                  <Button Content="Open" HorizontalAlignment="Stretch" Classes="command"
                          Command="{Binding $parent[Window].((vm:RemindersViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
