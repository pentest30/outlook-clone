<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Outlook.App.Views"
        x:Class="Outlook.App.Views.ToastWindow"
        x:DataType="views:ToastContent"
        Title="New mail"
        Width="380" SizeToContent="Height"
        SystemDecorations="None" Topmost="True" ShowActivated="False" ShowInTaskbar="False" CanResize="False"
        Background="Transparent" TransparencyLevelHint="Transparent">
  <!-- A desktop alert in the corner of the screen: sender, subject, preview. Click to open. -->
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
          CornerRadius="8" Padding="14,12" Margin="0" Cursor="Hand">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Image Source="/Assets/app.png" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,12,0" />
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Text="{Binding Heading}" FontSize="11" Classes="muted" />
        <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Preview}" FontSize="12" Classes="muted" TextWrapping="Wrap" MaxHeight="34"
                   TextTrimming="CharacterEllipsis" IsVisible="{Binding HasPreview}" />
      </StackPanel>
      <Button Grid.Column="2" x:Name="CloseButton" Padding="6" VerticalAlignment="Top"
              Background="Transparent" BorderThickness="0" ToolTip.Tip="Dismiss">
        <PathIcon Width="11" Height="11" Data="{StaticResource Icon.Dismiss}" />
      </Button>
    </Grid>
  </Border>
</Window>
