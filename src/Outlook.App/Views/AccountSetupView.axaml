<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Outlook.App.ViewModels"
             x:Class="Outlook.App.Views.AccountSetupView"
             x:DataType="vm:AccountSetupViewModel">
  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="28,24" Width="520"
          HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 8 32 0 #40000000">
    <StackPanel Spacing="10">
      <TextBlock Text="Add an account" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Any IMAP/SMTP mailbox. Microsoft 365 and Gmail need OAuth sign-in, which arrives in Phase 3."
                 TextWrapping="Wrap" Classes="muted" />

      <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
        <TextBox Watermark="Your name" Text="{Binding DisplayName}" />
        <TextBox Grid.Column="2" Watermark="Email address" Text="{Binding Email}" />
      </Grid>
      <Grid ColumnDefinitions="*,12,*">
        <TextBox Watermark="User name" Text="{Binding UserName}" />
        <TextBox Grid.Column="2" Watermark="Password" PasswordChar="•" Text="{Binding Password}" />
      </Grid>

      <TextBlock Text="Incoming mail (IMAP)" FontWeight="SemiBold" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="*,8,80,8,140">
        <TextBox Watermark="Server" Text="{Binding ImapHost}" />
        <NumericUpDown Grid.Column="2" Value="{Binding ImapPort}" Minimum="1" Maximum="65535" ShowButtonSpinner="False" FormatString="0" />
        <ComboBox Grid.Column="4" HorizontalAlignment="Stretch"
                  ItemsSource="{x:Static vm:AccountSetupViewModel.SecurityOptions}" SelectedItem="{Binding ImapSecurity}" />
      </Grid>

      <TextBlock Text="Outgoing mail (SMTP)" FontWeight="SemiBold" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="*,8,80,8,140">
        <TextBox Watermark="Server" Text="{Binding SmtpHost}" />
        <NumericUpDown Grid.Column="2" Value="{Binding SmtpPort}" Minimum="1" Maximum="65535" ShowButtonSpinner="False" FormatString="0" />
        <ComboBox Grid.Column="4" HorizontalAlignment="Stretch"
                  ItemsSource="{x:Static vm:AccountSetupViewModel.SecurityOptions}" SelectedItem="{Binding SmtpSecurity}" />
      </Grid>

      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource FlagBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <Button Classes="command" Content="Use local test server" Command="{Binding UseLocalTestServerCommand}"
                ToolTip.Tip="GreenMail from docker-compose.yml" />
        <Button Grid.Column="1" Classes="primary" Content="Sign in" Command="{Binding SignInCommand}" IsDefault="True" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
