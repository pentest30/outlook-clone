<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Outlook.App.ViewModels"
        x:Class="Outlook.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="680" Height="560" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="90" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
      </StackPanel>
    </Border>

    <TabControl x:Name="Tabs" TabStripPlacement="Left" Padding="20,8" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Accounts" IsVisible="{Binding HasAccountsHost}">
        <DockPanel DataContext="{Binding AccountsHost}" x:DataType="vm:MainWindowViewModel">
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
            <TextBlock Text="Accounts" Classes="paneTitle" />
            <TextBlock Text="Changes here apply straight away. Open switches the window to that account."
                       FontSize="12" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Button DockPanel.Dock="Bottom" Classes="primary" Content="＋  Add account" Command="{Binding AddAccountCommand}"
                  HorizontalAlignment="Left" Margin="0,10,0,0" />
          <ItemsControl ItemsSource="{Binding Accounts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AccountRowViewModel">
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Email}" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="7,1" IsVisible="{Binding IsActive}">
                          <TextBlock Text="Open" FontSize="11" Foreground="White" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="12" Classes="muted" />
                      <TextBlock Text="{Binding Servers}" FontSize="12" Classes="muted" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <Button Classes="command" Content="Open" IsVisible="{Binding !IsActive}"
                              Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SwitchToCommand}" CommandParameter="{Binding}" />
                      <Button Classes="command" Content="Edit…"
                              Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).EditAccountCommand}" CommandParameter="{Binding}" />
                      <Button Classes="command" Content="Remove"
                              Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveAccountCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </TabItem>

      <TabItem Header="General">
        <StackPanel Spacing="14">
          <TextBlock Text="General" Classes="paneTitle" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Theme" VerticalAlignment="Center" Width="140" />
            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Themes}" SelectedItem="{Binding Theme}" MinWidth="160" />
          </StackPanel>
          <CheckBox Content="Show a desktop alert when new mail arrives" IsChecked="{Binding NewMailNotifications}" />
          <TextBlock Text="Alerts appear in the corner of the screen while Outlook Clone is in the background. Calendar reminders always show."
                     TextWrapping="Wrap" FontSize="12" Classes="muted" />
          <CheckBox Content="Keep running in the notification area when the window is closed" IsChecked="{Binding CloseToTray}" />
          <TextBlock Text="New mail and reminders keep arriving. Use Exit in the notification-area icon's menu to quit."
                     TextWrapping="Wrap" FontSize="12" Classes="muted" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Mail">
        <StackPanel Spacing="14">
          <TextBlock Text="Mail" Classes="paneTitle" />
          <CheckBox Content="Show messages as conversations" IsChecked="{Binding ShowAsConversations}" />
          <CheckBox Content="Mark messages as read when opened in the reading pane" IsChecked="{Binding MarkReadWhenOpened}" />
          <StackPanel Spacing="6">
            <TextBlock Text="Undo send" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Slider Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Width="260"
                      Value="{Binding UndoSendSeconds}" />
              <TextBlock Text="{Binding UndoSendText}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="Signature">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
            <TextBlock Text="Signature" Classes="paneTitle" />
            <TextBlock Text="{Binding AccountEmail, StringFormat='For {0}. Added to new messages.'}" FontSize="12" Classes="muted"
                       IsVisible="{Binding HasAccount}" />
            <TextBlock Text="Add an account first." FontSize="12" Classes="muted" IsVisible="{Binding !HasAccount}" />
          </StackPanel>
          <CheckBox DockPanel.Dock="Bottom" Content="Also add it to replies and forwards" IsChecked="{Binding SignatureOnReplies}" Margin="0,10,0,0" />
          <TextBox Text="{Binding Signature}" AcceptsReturn="True" TextWrapping="Wrap" IsEnabled="{Binding HasAccount}"
                   Watermark="Sam Taylor&#x0a;Example Corp&#x0a;+33 1 23 45 67 89" MinHeight="160" />
        </DockPanel>
      </TabItem>

      <TabItem Header="Calendar">
        <StackPanel Spacing="14">
          <TextBlock Text="Calendar" Classes="paneTitle" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Default reminder" VerticalAlignment="Center" Width="140" />
            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.ReminderOptions}" SelectedItem="{Binding DefaultReminder}" MinWidth="160" />
          </StackPanel>
          <TextBlock Text="Used for new appointments; each appointment can still choose its own." FontSize="12" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
