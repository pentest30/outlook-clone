<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Outlook.App.ViewModels"
        xmlns:controls="using:Outlook.App.Controls"
        x:Class="Outlook.App.Views.AppointmentWindow"
        x:DataType="vm:AppointmentEditorViewModel"
        Title="{Binding WindowTitle}"
        Width="760" Height="680" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource PaneBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,6">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="primary" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" ToolTip.Tip="Ctrl+S" />
        <Button Classes="command" Command="{Binding DeleteCommand}" IsVisible="{Binding !IsNew}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.Delete}" />
            <TextBlock Text="Delete" />
          </StackPanel>
        </Button>
        <Rectangle Width="1" Fill="{DynamicResource DividerBrush}" Margin="8,4" />
        <TextBlock Text="Show as" VerticalAlignment="Center" Margin="4,0" Classes="muted" />
        <ComboBox ItemsSource="{x:Static vm:AppointmentEditorViewModel.ShowAsOptions}" SelectedItem="{Binding ShowAs}" MinWidth="120" />
        <TextBlock Text="Reminder" VerticalAlignment="Center" Margin="12,0,4,0" Classes="muted" />
        <ComboBox ItemsSource="{x:Static vm:AppointmentEditorViewModel.ReminderOptions}" SelectedItem="{Binding Reminder}" MinWidth="130" />
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="{DynamicResource FlagBrush}" Margin="16,4,16,8" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="16,12" IsEnabled="{Binding CanEdit}">
      <TextBlock Grid.ColumnSpan="2" Text="{Binding OrganizerText}" IsVisible="{Binding HasOrganizerText}" Classes="muted" Margin="0,0,0,8" />

      <TextBlock Grid.Row="1" Text="Title" VerticalAlignment="Center" Margin="0,0,12,0" Classes="muted" />
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="TitleBox" Text="{Binding Subject}" Watermark="Add a title" Margin="0,3" />

      <TextBlock Grid.Row="2" Text="Attendees" VerticalAlignment="Center" Margin="0,0,12,0" Classes="muted" />
      <AutoCompleteBox Grid.Row="2" Grid.Column="1" Text="{Binding Attendees, Mode=TwoWay}" Margin="0,3"
                       Watermark="Invite people: addresses separated by ; or , (makes this a meeting)"
                       FilterMode="None" MinimumPrefixLength="1" MinimumPopulateDelay="0:0:0.15"
                       AsyncPopulator="{Binding SuggestRecipients}" TextSelector="{x:Static controls:RecipientCompletion.Selector}" />

      <TextBlock Grid.Row="3" Text="Start" VerticalAlignment="Center" Margin="0,0,12,0" Classes="muted" />
      <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,3">
        <CalendarDatePicker SelectedDate="{Binding StartDate}" Width="170" />
        <TimePicker SelectedTime="{Binding StartTime}" MinuteIncrement="15" IsVisible="{Binding ShowTimes}" />
        <CheckBox Content="All day" IsChecked="{Binding IsAllDay}" Margin="8,0,0,0" />
      </StackPanel>

      <TextBlock Grid.Row="4" Text="End" VerticalAlignment="Center" Margin="0,0,12,0" Classes="muted" />
      <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,3">
        <CalendarDatePicker SelectedDate="{Binding EndDate}" Width="170" />
        <TimePicker SelectedTime="{Binding EndTime}" MinuteIncrement="15" IsVisible="{Binding ShowTimes}" />
      </StackPanel>

      <TextBlock Grid.Row="5" Text="Repeat" VerticalAlignment="Center" Margin="0,0,12,0" Classes="muted" />
      <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,3">
        <ComboBox ItemsSource="{x:Static vm:AppointmentEditorViewModel.RepeatOptions}" SelectedItem="{Binding Repeat}" MinWidth="170" />
        <TextBlock Text="until" VerticalAlignment="Center" Classes="muted" IsVisible="{Binding ShowRepeatUntil}" />
        <CalendarDatePicker SelectedDate="{Binding RepeatUntil}" Width="170" Watermark="No end date"
                            IsVisible="{Binding ShowRepeatUntil}" />
      </StackPanel>

      <TextBlock Grid.Row="6" Text="Location" VerticalAlignment="Center" Margin="0,0,12,0" Classes="muted" />
      <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Location}" Watermark="Room, address or meeting link" Margin="0,3" />

      <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="{Binding Responses}" IsVisible="{Binding HasResponses}"
                 FontSize="12" Classes="muted" TextWrapping="Wrap" Margin="0,6" />

      <TextBox Grid.Row="8" Grid.ColumnSpan="2" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap"
               Watermark="Notes" Margin="0,8,0,0" />
    </Grid>
  </DockPanel>
</Window>
