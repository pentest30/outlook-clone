<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Outlook.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://OutlookClone/Styles/OutlookStyles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://OutlookClone/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Colours after Outlook's Fluent palette: a blue header in light, neutral greys in dark. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
          <SolidColorBrush x:Key="HeaderBrush" Color="#0F6CBD" />
          <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SearchBoxBrush" Color="#E9F2FB" />
          <SolidColorBrush x:Key="SearchBoxForegroundBrush" Color="#242424" />
          <SolidColorBrush x:Key="CommandBarBrush" Color="#FAFAFA" />
          <SolidColorBrush x:Key="PaneBrush" Color="#F5F5F5" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DividerBrush" Color="#E0E0E0" />
          <SolidColorBrush x:Key="HoverBrush" Color="#EBEBEB" />
          <SolidColorBrush x:Key="SelectedBrush" Color="#CFE4FA" />
          <SolidColorBrush x:Key="BadgeBrush" Color="#E6E6E6" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#616161" />
          <SolidColorBrush x:Key="FlagBrush" Color="#C50F1F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AccentBrush" Color="#479EF5" />
          <SolidColorBrush x:Key="HeaderBrush" Color="#141414" />
          <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#E8E8E8" />
          <SolidColorBrush x:Key="SearchBoxBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="SearchBoxForegroundBrush" Color="#E8E8E8" />
          <SolidColorBrush x:Key="CommandBarBrush" Color="#1C1C1C" />
          <SolidColorBrush x:Key="PaneBrush" Color="#1F1F1F" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#292929" />
          <SolidColorBrush x:Key="DividerBrush" Color="#383838" />
          <SolidColorBrush x:Key="HoverBrush" Color="#333333" />
          <SolidColorBrush x:Key="SelectedBrush" Color="#0E3A63" />
          <SolidColorBrush x:Key="BadgeBrush" Color="#3A3A3A" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#ADADAD" />
          <SolidColorBrush x:Key="FlagBrush" Color="#F1707B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
